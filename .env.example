# Copy this file to ".env" and fill it in. Never share or upload your .env file.

# ---- Kroll SFTP ----
KROLL_SFTP_HOST=ftp.krollcorp.com
KROLL_SFTP_PORT=22
KROLL_SFTP_USER=131856
KROLL_SFTP_PASSWORD=put-your-kroll-password-here
KROLL_REMOTE_PATH=/ProductData/Kroll_Stock_Inventory.csv

# Only needed if the script can't guess the column names (it prints them each run).
KROLL_SKU_COLUMN=
KROLL_QTY_COLUMN=

# ---- Shopify ----
SHOPIFY_STORE=96ba13-6e
# Use ONE of these two options (see README, step 2):
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=

# The Shopify location that should hold Kroll's stock numbers. Must match exactly.
# Your locations: Shop location, WCU - SO-CAL, WCU NOR-CAL, WCU - MI, ROTHCO, First Tactical - Returns
SHOPIFY_LOCATION_NAME=Shop location

# ---- Matching (optional) ----
# If your Shopify SKUs = a prefix + Kroll's SKU (for example "KR-12345"), put the prefix here.
SHOPIFY_SKU_PREFIX=
# Only update products from these vendors (comma-separated). Leave blank for all.
ONLY_VENDORS=
# Show this many fewer than Kroll has, to avoid overselling. 0 = exact Kroll number.
SAFETY_BUFFER=0

# ---- Safety ----
# true = only make a report, change nothing. Set to false once the report looks right.
DRY_RUN=true
# Stop if the Kroll file has fewer SKUs than this (protects against a broken file).
MIN_KROLL_ROWS=100
# Stop if more than this % of matched items would drop to zero in one run.
MAX_ZERO_PERCENT=30
